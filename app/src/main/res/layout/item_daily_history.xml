<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:orientation="vertical">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
      <TextView
          android:id="@+id/daily_date"
          style="@style/Aqua.Text"
          android:textStyle="bold"
          android:textSize="15sp"
          android:text="" />
      <TextView
          android:id="@+id/daily_subtext"
          style="@style/Aqua.Caption"
          android:textSize="12sp"
          android:paddingTop="2dp"
          android:text="" />
    </LinearLayout>

    <TextView
        android:id="@+id/daily_amount"
        style="@style/Aqua.Metric"
        android:textSize="18sp"
        android:gravity="end"
        android:text="" />
  </LinearLayout>

  <ProgressBar
      android:id="@+id/daily_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="6dp"
      android:layout_marginTop="10dp"
      android:progressTint="@color/aqua_blue" />
</LinearLayout>
