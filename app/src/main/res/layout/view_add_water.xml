<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <ImageView android:id="@+id/btnReopenCard" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:src="@drawable/water_icon" android:background="@drawable/bg_circle_selected" android:padding="16dp" android:contentDescription="Mở thẻ thêm nước" android:visibility="gone" android:clickable="true" android:focusable="true" />
  <LinearLayout android:id="@+id/cardAddWater" android:orientation="vertical" android:background="@drawable/bg_add_water_card" android:elevation="12dp" android:layout_marginTop="0dp" android:layout_width="match_parent" android:layout_height="wrap_content" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android" android:clickable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
      <!-- Header Thẻ -->
      <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Thêm nước" android:textSize="20sp" android:textStyle="bold" android:textColor="#10253F" android:drawablePadding="12dp" android:drawableStart="@android:drawable/ic_menu_add" android:drawableTint="#29B6F6" />
        <ImageView android:id="@+id/btnCloseCard" android:layout_width="48dp" android:layout_height="48dp" android:layout_alignParentEnd="true" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#8FA3B8" android:contentDescription="Ẩn thẻ thêm nước" android:padding="10dp" />
      </RelativeLayout>
      <!-- Loại đồ uống -->
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loại đồ uống" android:textColor="#546E7A" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:weightSum="4" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
          <ImageView android:id="@+id/ivWater" android:contentDescription="Nước lọc" android:clickable="true" android:focusable="true" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle_selected" android:src="@drawable/water_icon" android:padding="12dp" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nước lọc" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="#546E7A" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
          <ImageView android:id="@+id/ivTea" android:contentDescription="Trà / Cafe" android:clickable="true" android:focusable="true" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle_unselected" android:src="@drawable/cafe_icon" android:padding="12dp" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trà / Cafe" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="#546E7A" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
          <ImageView android:id="@+id/ivSweet" android:contentDescription="Nước ngọt" android:clickable="true" android:focusable="true" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle_unselected" android:src="@drawable/sweet_icon" android:padding="12dp" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nước ngọt" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="#546E7A" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
          <ImageView android:id="@+id/ivMilk" android:contentDescription="Sữa" android:clickable="true" android:focusable="true" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_circle_unselected" android:src="@drawable/milk_icon" android:padding="12dp" />
          <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sữa" android:textSize="12sp" android:layout_marginTop="8dp" android:textColor="#546E7A" />
        </LinearLayout>
      </LinearLayout>
      <!-- Chọn lượng nước -->
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lượng nước (ml)" android:textColor="#546E7A" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="5">
        <Button android:id="@+id/btn100ml" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="100" android:textColor="#29B6F6" android:background="@drawable/bg_add_water_button" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
        <Button android:id="@+id/btn200ml" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="200" android:textColor="#29B6F6" android:background="@drawable/bg_add_water_button" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
        <Button android:id="@+id/btn300ml" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="300" android:textColor="#29B6F6" android:background="@drawable/bg_add_water_button" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
        <Button android:id="@+id/btn500ml" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="500" android:textColor="#29B6F6" android:background="@drawable/bg_add_water_button" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
        <Button android:id="@+id/btnCustom" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Khác" android:textColor="#29B6F6" android:background="@drawable/bg_add_water_button" android:padding="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
      </LinearLayout>
      <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E1F5FE" android:layout_marginTop="8dp" />
      <!-- Nút Link Mở Sang Trang Lịch Sử -->
      <TextView android:id="@+id/tvGoToHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lịch sử uống nước  ➔" android:textSize="16sp" android:textStyle="bold" android:textColor="#29B6F6" android:gravity="center" android:padding="8dp" android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>