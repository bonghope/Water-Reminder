<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView style="@style/Aqua.Title" android:text="Lịch sử uống nước" />
  <TextView style="@style/Aqua.Caption" android:text="Những ngụm nước tạo nên thói quen tốt." />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/filter_today" style="@style/Aqua.Choice" android:text="Hôm nay" />
    <TextView android:id="@+id/filter_week" style="@style/Aqua.Choice" android:text="7 ngày qua" />
  </LinearLayout>
  <LinearLayout android:id="@+id/history_summary" style="@style/Aqua.Card" android:orientation="vertical">
    <TextView style="@style/Aqua.Caption" android:text="Hôm nay đã uống" />
    <TextView android:id="@+id/history_total" style="@style/Aqua.Metric" android:text="" />
  </LinearLayout>
  <TextView android:id="@+id/history_hint" style="@style/Aqua.Caption" android:text="Vuốt sang trái để sửa hoặc xóa bản ghi." />
  <LinearLayout android:id="@+id/log_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
</LinearLayout>