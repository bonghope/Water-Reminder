<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="20dp" android:paddingRight="20dp">


  <LinearLayout style="@style/Aqua.Card" android:background="@android:color/transparent" android:minHeight="0dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:orientation="vertical" android:gravity="center_horizontal">
    <TextView style="@style/Aqua.Text" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="TIẾN ĐỘ HÔM NAY" />
    <TextView android:id="@+id/home_percent" style="@style/Aqua.Text" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="44sp" android:textStyle="bold" />
    <TextView android:id="@+id/home_amount" style="@style/Aqua.Text" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="20sp" />
    <TextView android:id="@+id/home_remaining" style="@style/Aqua.Text" android:paddingTop="2dp" android:paddingBottom="2dp" android:text="" />
  </LinearLayout>
  </LinearLayout>
</LinearLayout>
