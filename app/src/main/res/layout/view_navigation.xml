<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="84dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:layout_gravity="bottom" android:orientation="horizontal" android:background="#FFFFFF" android:gravity="center_vertical">
    <TextView android:id="@+id/nav_0" style="@style/Aqua.BottomNav" android:text="Trang chủ" android:drawableTop="@android:drawable/ic_menu_view" />
    <TextView android:id="@+id/nav_1" style="@style/Aqua.BottomNav" android:text="Lịch sử" android:drawableTop="@android:drawable/ic_menu_recent_history" />
    <TextView android:id="@+id/nav_2" style="@style/Aqua.BottomNav" android:text="Thống kê" android:drawableTop="@android:drawable/ic_menu_sort_by_size" />
    <Space android:layout_width="72dp" android:layout_height="match_parent" />
    <TextView android:id="@+id/nav_3" style="@style/Aqua.BottomNav" android:text="Thú cưng" android:drawableTop="@android:drawable/ic_menu_myplaces" />
    <TextView android:id="@+id/nav_4" style="@style/Aqua.BottomNav" android:text="Nhắc nhở" android:drawableTop="@android:drawable/ic_popup_reminder" />
    <TextView android:id="@+id/nav_5" style="@style/Aqua.BottomNav" android:text="Cài đặt" android:drawableTop="@android:drawable/ic_menu_preferences" />
  </LinearLayout>
  <ImageView android:id="@+id/nav_add_water" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="top|center_horizontal" android:background="@drawable/bg_circle_selected" android:src="@drawable/water_icon" android:padding="16dp" android:elevation="12dp" android:contentDescription="Thêm nước" android:clickable="true" android:focusable="true" />
</FrameLayout>
