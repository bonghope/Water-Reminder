<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp">

  <!-- Bottom Navigation Bar Surface -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="58dp"
      android:layout_gravity="bottom"
      android:orientation="horizontal"
      android:background="?attr/aquaSurface"
      android:elevation="6dp"
      android:gravity="center_vertical"
      android:paddingLeft="2dp"
      android:paddingRight="2dp">

    <!-- 3 Tabs Left -->
    <TextView
        android:id="@+id/nav_0"
        style="@style/Aqua.BottomNav"
        android:text="Trang chủ"
        android:drawableTop="@drawable/ic_nav_home" />

    <TextView
        android:id="@+id/nav_1"
        style="@style/Aqua.BottomNav"
        android:text="Lịch sử"
        android:drawableTop="@drawable/ic_nav_history" />

    <TextView
        android:id="@+id/nav_2"
        style="@style/Aqua.BottomNav"
        android:text="Thống kê"
        android:drawableTop="@drawable/ic_nav_stats" />

    <!-- Center Space for Floating Add Water '+' Button -->
    <Space
        android:layout_width="56dp"
        android:layout_height="match_parent" />

    <!-- 3 Tabs Right -->
    <TextView
        android:id="@+id/nav_3"
        style="@style/Aqua.BottomNav"
        android:text="Thú cưng"
        android:drawableTop="@drawable/ic_nav_pet" />

    <TextView
        android:id="@+id/nav_4"
        style="@style/Aqua.BottomNav"
        android:text="Nhắc nhở"
        android:drawableTop="@drawable/ic_nav_reminder" />

    <TextView
        android:id="@+id/nav_5"
        style="@style/Aqua.BottomNav"
        android:text="Cài đặt"
        android:drawableTop="@drawable/ic_nav_settings" />

  </LinearLayout>

  <!-- Central Floating '+' Button to Drink Water -->
  <ImageView
      android:id="@+id/nav_add_water"
      android:layout_width="54dp"
      android:layout_height="54dp"
      android:layout_gravity="top|center_horizontal"
      android:background="@drawable/bg_fab_add_water"
      android:src="@drawable/ic_add_plus_white"
      android:padding="13dp"
      android:elevation="12dp"
      android:contentDescription="Uống nước (+)"
      android:clickable="true"
      android:focusable="true" />

</FrameLayout>
