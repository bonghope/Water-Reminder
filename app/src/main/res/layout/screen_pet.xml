<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView style="@style/Aqua.Title" android:text="Hành trình của bạn" />
  <TextView style="@style/Aqua.Caption" android:text="Chăm mình khỏe, nuôi giọt nước lớn lên từng ngày." />

  <LinearLayout style="@style/Aqua.Card" android:orientation="vertical" android:gravity="center_horizontal">
    <com.aqua.water.ui.PetView android:id="@+id/pet_mascot" android:layout_width="match_parent" android:layout_height="250dp" />
    <TextView android:id="@+id/pet_dialogue" style="@style/Aqua.Text" android:gravity="center" android:text="Hãy uống đủ nước mỗi ngày để lớn lên nhé" android:textStyle="italic" android:paddingTop="2dp" android:paddingBottom="6dp" />

    <TextView android:id="@+id/pet_name" style="@style/Aqua.Metric" android:gravity="center" android:text="" />
    <TextView android:id="@+id/pet_level" style="@style/Aqua.Caption" android:gravity="center" android:text="" />
    <ProgressBar android:id="@+id/pet_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:progressTint="@color/aqua_blue" />
  </LinearLayout>

  <LinearLayout android:id="@+id/pet_streak_card" style="@style/Aqua.Card" android:background="@drawable/bg_streak_card" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp">
    <com.aqua.water.ui.FlameView android:id="@+id/pet_streak_icon" android:layout_width="48dp" android:layout_height="48dp" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="6dp">
      <TextView android:id="@+id/pet_streak_title" style="@style/Aqua.Text" android:textColor="#ff5722" android:textStyle="bold" android:text="Năng lượng Chuỗi ngày" />
      <TextView android:id="@+id/pet_streak_desc" style="@style/Aqua.Caption" android:text="Chuỗi 0 ngày liên tiếp • Uống 100% để giữ lửa!" />
    </LinearLayout>
  </LinearLayout>

  <TextView style="@style/Aqua.Title" android:text="4 Cấp độ tiến hóa" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/pet_small" style="@style/Aqua.Choice" android:textSize="11sp" android:text="Cấp 1" />
    <TextView android:id="@+id/pet_growing" style="@style/Aqua.Choice" android:textSize="11sp" android:text="Cấp 2" />
    <TextView android:id="@+id/pet_healthy" style="@style/Aqua.Choice" android:textSize="11sp" android:text="Cấp 3" />
    <TextView android:id="@+id/pet_bright" style="@style/Aqua.Choice" android:textSize="11sp" android:text="Cấp 4" />
  </LinearLayout>
  <TextView style="@style/Aqua.Caption" android:text="Hoàn thành 100% mục tiêu hôm nay để đạt Cấp 4 (Chiến Binh Nước)" />
</LinearLayout>
