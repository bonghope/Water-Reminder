<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:theme="@style/Theme.Aqua" android:label="Aqua • Uống nước" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name="com.aqua.water.ui.MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <receiver android:name="com.aqua.water.services.ReminderReceiver" android:exported="false" />
        <receiver android:name="com.aqua.water.services.BootReceiver" android:exported="true"><intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter></receiver>
    </application>
</manifest>
